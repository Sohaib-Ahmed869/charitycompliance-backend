
# ==============================
# Backend (.gitignore)
# Node/Express/Mongo (MERN)
# ==============================

# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example
env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Build output
dist/
build/

# Caches
.cache/
.parcel-cache/
.eslintcache

# Uploads / generated files
uploads/
tmp/
temp/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Internal / personal (not for repo)
personal/

# Editor/IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

